    { "name": "EffectCraft", "short_name": "Effect", "description": "โมชันกราฟิก / VFX", "url": "./#effectcraft",
      "icons": [{ "src": "icons/effectcraft.png", "sizes": "256x256", "type": "image/png" }] }
  ]
